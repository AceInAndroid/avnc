 rfbBool errorMessageOnReadFailure = TRUE;
 
+/* All socket waits are bounded so cancellation never touches a live descriptor
+ * from another thread. Deadlines measure a stall, not a quiet desktop's age. */
+static uint64_t io_now_ms(void)
+{
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (uint64_t)now.tv_sec * 1000 + now.tv_nsec / 1000000;
+}
+
+rfbBool rfbClientIoCancelled(rfbClient* client)
+{
+  if (client && client->IsCancelled && client->IsCancelled(client)) {
+    errno = ECANCELED;
+    return TRUE;
+  }
+  return FALSE;
+}
+
+uint64_t rfbClientIoDeadline(unsigned int seconds)
+{
+  return seconds ? io_now_ms() + (uint64_t)seconds * 1000 : 0;
+}
+
+int rfbClientWaitForIo(rfbClient* client, rfbSocket sock, rfbBool writing, uint64_t deadline)
+{
+  for (;;) {
+    fd_set fds;
+    struct timeval wait;
+    uint64_t milliseconds = 100;
+    int result;
+    if (rfbClientIoCancelled(client)) return -1;
+    if (sock == RFB_INVALID_SOCKET || sock >= FD_SETSIZE) { errno = EBADF; return -1; }
+    if (deadline) {
+      uint64_t now = io_now_ms();
+      if (now >= deadline) { errno = ETIMEDOUT; return -1; }
+      if (deadline - now < milliseconds) milliseconds = deadline - now;
+    }
+    FD_ZERO(&fds);
+    FD_SET(sock, &fds);
+    wait.tv_sec = 0;
+    wait.tv_usec = milliseconds * 1000;
+    result = select(sock + 1, writing ? NULL : &fds, writing ? &fds : NULL, NULL, &wait);
+    if (rfbClientIoCancelled(client)) return -1;
+    if (result > 0) return result;
+    if (result < 0 && errno != EINTR) return -1;
+  }
+}
+
+static rfbBool wait_for_connected(rfbClient* client, rfbSocket sock, uint64_t deadline)
+{
+  int error = 0;
+  socklen_t length = sizeof(error);
+  if (rfbClientWaitForIo(client, sock, TRUE, deadline) < 0) return FALSE;
+  if (getsockopt(sock, SOL_SOCKET, SO_ERROR, (char*)&error, &length) < 0) return FALSE;
+  if (error) { errno = error; return FALSE; }
+  return TRUE;
+}
+
+static void configure_keepalive(rfbSocket sock)
+{
+  int value = 1;
+  setsockopt(sock, SOL_SOCKET, SO_KEEPALIVE, (char*)&value, sizeof(value));
+#ifdef TCP_KEEPIDLE
+  value = 15;
+  setsockopt(sock, IPPROTO_TCP, TCP_KEEPIDLE, (char*)&value, sizeof(value));
+#endif
+#ifdef TCP_KEEPINTVL
+  value = 5;
+  setsockopt(sock, IPPROTO_TCP, TCP_KEEPINTVL, (char*)&value, sizeof(value));
+#endif
+#ifdef TCP_KEEPCNT
+  value = 3;
+  setsockopt(sock, IPPROTO_TCP, TCP_KEEPCNT, (char*)&value, sizeof(value));
+#endif
+#ifdef TCP_USER_TIMEOUT
+  value = 15000;
+  setsockopt(sock, IPPROTO_TCP, TCP_USER_TIMEOUT, (char*)&value, sizeof(value));
+#endif
+}

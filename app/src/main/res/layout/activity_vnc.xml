<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.gaurav.avnc.viewmodel.VncViewModel.State" />

        <variable
            name="viewModel"
            type="com.gaurav.avnc.viewmodel.VncViewModel" />
    </data>

    <!--
    There are three components of this screen:

    1. FrameView :- Renders remote content. This is "behind" all other Views.

    2. Controls  :- Viewer-local capsule, menus and touchpad rendered above FrameView.

    3. Status    :- Topmost View. Shows progress indicator, status msg etc. It is initially
                    visible but becomes invisible once we are successfully connected to server.
    -->

    <FrameLayout
        android:id="@+id/viewer_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <FrameLayout
            android:id="@+id/drawer_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/frame_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!--FrameView-->
                <com.gaurav.avnc.ui.vnc.FrameView
                    android:id="@+id/frame_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:background="@drawable/bg_frame_view" /> <!--Workaround for hole punching issues-->

                <com.gaurav.avnc.ui.vnc.input.InputView
                    android:id="@+id/input_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ViewStub
                    android:id="@+id/no_video_overlay_stub"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout="@layout/no_video_overlay" />

                <!--Virtual keys-->
                <ViewStub
                    android:id="@+id/virtual_keys_stub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout="@layout/virtual_keys" />

                <FrameLayout
                    android:id="@+id/touchpad_host"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <!--A View containing helpful tips will be dynamically inserted here for new users -->


        </FrameLayout>

        <LinearLayout
            android:id="@+id/keyboard_host"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <FrameLayout
                android:id="@+id/keyboard_content_host"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/touchpad_dock"
                android:layout_width="220dp"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </LinearLayout>

        </LinearLayout>

        <!-- Connection-entry UI is rendered from existing session state. -->
        <FrameLayout
            android:id="@+id/status_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/shell_background">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/auto_reconnect_progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:visibility="gone"
                app:indicatorColor="@color/shell_blue"
                app:indicatorSize="28dp"
                app:indicatorInset="2dp"
                app:trackThickness="2dp" />
        </FrameLayout>

    </FrameLayout>
</layout>

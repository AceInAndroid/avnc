<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    app:title="@string/settings_appearance">

    <ListPreference
        app:defaultValue="system"
        app:entries="@array/theme_entries"
        app:entryValues="@array/theme_values"
        app:key="theme"
        app:title="@string/pref_theme"
        app:useSimpleSummaryProvider="true" />

    <SwitchPreference
        app:defaultValue="true"
        app:key="bell_enabled"
        app:title="@string/pref_bell"/>

    <SwitchPreference
        app:defaultValue="false"
        app:key="sort_server_list"
        app:title="@string/pref_sort_server_list" />

    <SwitchPreference
        app:defaultValue="false"
        app:key="prefer_advanced_editor"
        app:title="@string/pref_prefer_advanced_editor" />

    <Preference app:key="settings_viewer" app:title="@string/pref_viewer" app:summary="@string/pref_viewer_summary"
        app:fragment="com.gaurav.avnc.ui.prefs.PrefsActivity$Viewer" />
</PreferenceScreen>